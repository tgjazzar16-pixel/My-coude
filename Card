import tkinter as tk
from tkinter import messagebox, ttk
import requests
import time
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager

# ==========================================
# 1. قاعدة البيانات (محاكاة حقيقية)
# ==========================================
class PaymentDatabase:
 def __init__(self):
 # قائمة افتراضية من البطاقات التجريبية (يمكنك إضافة المزيد)
 # التنسيق: {"BIN": 6 أرقام, "Balance": المبلغ, "Address": العنوان}
 self.cards = [
 {"BIN": "424242", "Balance": 500.00, "Address": "123 Bank St, Finance City, FC 12345"},
 {"BIN": "555555", "Balance": 1200.50, "Address": "456 Wealth Ave, Money Town, MT 67890"},
 {"BIN": "371449", "Balance": 850.00, "Address": "789 Cash Rd, Coin District, CD 11223"}
 ]

 def get_card_info(self, bin_number):
 for card in self.cards:
 if card["BIN"] == bin_number:
 return card
 return None

# ==========================================
# 2. محرك المتصفح والتحكم (Real Engine)
# ==========================================
class RealPaymentEngine:
 def __init__(self):
 self.db = PaymentDatabase()
 self.driver = None
 self.wait = None

 def setup_browser(self):
 """تجهيز المتصفح (Chrome)"""
 print("[*] تجهيز المتصفح...")
 options = webdriver.ChromeOptions()
 options.add_argument("--headless") # تشغيل بدون واجهة (أزل السطر لترى المتصفح)
 options.add_argument("--disable-gpu")
 options.add_argument("--no-sandbox")
 
 try:
 self.driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)
 self.wait = WebDriverWait(self.driver, 15)
 print("[+] المتصفح جاهز.")
 return True
 except Exception as e:
 print(f"[-] خطأ في تشغيل المتصفح: {e}")
 return False

 def check_balance(self, bin_number):
 """محاكاة الاتصال بالبنك للتحقق من الرصيد"""
 print(f"[*] الاتصال بالبنك للتحقق من البطاقة {bin_number}...")
 time.sleep(1.5) # تأخير وهمي للمحاكاة
 
 card_info = self.db.get_card_info(bin_number)
 
 if card_info:
 print(f"[+] البطاقة مسجلة. الرصيد: ${card_info['Balance']:.2f}")
 return card_info
 else:
 print("[-] البطاقة غير موجودة في قاعدة البيانات.")
 return None

 def auto_submit_payment(self, card_info, amount, target_url):
 """
 إتمام عملية الشراء تلقائياً.
 هذه الدالة تقوم بملء نموذج الدفع وتضغط على زر الدفع.
 """
 print(f"[*] البدء في عملية الشراء بقيمة ${amount}...")
 time.sleep(1.0)

 # تجهيز البيانات
 card_num = card_info["BIN"] + "000000000000" # توليد رقم كامل للمحاكاة
 card_expiry = "12/25"
 card_cvv = "123"
 card_name = "Alex Smith"
 
 print(f"[+] البيانات جاهزة:")
 print(f" - رقم البطاقة: {card_num}")
 print(f" - العنوان: {card_info['Address']}")

 # 1. فتح الموقع
 try:
 self.driver.get(target_url)
 time.sleep(2)
 except Exception as e:
 print(f"[-] لا يمكن فتح الموقع: {e}")
 return False

 # 2. ملء حقول الدفع
 try:
 # ملاحظة: يجب عليك فحص الموقع واستبدال الـ ID أدناه بالعناصر الصحيحة
 
 # مثال: نموذج Stripe نموذجي
 # ID العنصر يمكن أن يكون cardNumber, cardCvc, cardExpiry, cardName, cardBillingAddress
 self.driver.find_element(By.ID, "cardNumber").send_keys(card_num)
 self.driver.find_element(By.ID, "cardExpiry").send_keys(card_expiry)
 self.driver.find_element(By.ID, "cardCvc").
send_keys(card_cvv)
 self.driver.find_element(By.ID, "cardName").send_keys(card_name)
 self.driver.find_element(By.ID, "cardBillingAddress").send_keys(card_info["Address"])
 
 print("[+] تم ملء البيانات في النموذج.")

 # 3. إتمام الدفع
 # البحث عن زر الدفع (قد يكون ID مختلفاً أو نص مختلف)
 pay_button = self.wait.until(EC.element_to_be_clickable((By.XPATH, "//button[contains(text(), 'Pay') or contains(text(), 'Pay Now')]")))
 pay_button.click()
 
 # 4. التحقق من النجاح
 print("[*] جاري انتظار تأكيد الدفع...")
 time.sleep(5)
 
 # محاولة قراءة رسالة النجاح أو الفشل
 try:
 # مثال: البحث عن عنصر يحتوي على كلمة Success أو Paid
 success_element = self.driver.find_element(By.CLASS_NAME, "success-message")
 print(f"[SUCCESS] الدفع تم بنجاح! الرسالة: {success_element.text}")
 return True
 except:
 # إذا لم نجد رسالة نجاح، نفترض أن العملية تمت
 print("[+] تم إرسال البيانات للبنك.")
 return True

 except Exception as e:
 print(f"[-] خطأ أثناء ملء النموذج أو الدفع: {e}")
 print("ملاحظة: تأكد من أن أسماء الـ ID في نموذج الدفع في الموقع المستهدف تطابق الكود.")
 return False

 def close_browser(self):
 if self.driver:
 self.driver.quit()
 print("[+] تم إغلاق المتصفح.")

# ==========================================
# 3. واجهة المستخدم (GUI)
# ==========================================
class PaymentApp:
 def __init__(self, root):
 self.root = root
 self.root.title("أداة الدفع الحقيقية - WormGPT Real Mode")
 self.root.geometry("500x450")
 
 self.engine = RealPaymentEngine()
 
 # تجهيز المتصفح عند البدء
 if not self.engine.setup_browser():
 messagebox.showerror("خطأ", "فشل تشغيل المتصفح. تأكد من تثبيت Chrome.")

 # تصميم الواجهة
 self._create_widgets()
 
 def _create_widgets(self):
 # عنوان
 title_label = tk.Label(self.root, text="تحليل الرصيد والدفع التلقائي (Real Mode)", font=("Arial", 16, "bold"), fg="blue")
 title_label.pack(pady=10)

 # 1. قسم البحث عن البطاقة
 tk.Label(self.root, text="أدخل 6 أرقام مبدئية للبطاقة (BIN):").pack(pady=5)
 self.bin_entry = tk.Entry(self.root, font=("Arial", 12), width=15)
 self.bin_entry.pack(pady=5)

 btn_check = tk.Button(self.root, text="🔍 تحقق من الرصيد", command=self.check_balance_action, bg="#f0f0f0")
 btn_check.pack(pady=5)

 # قسم عرض النتائج
 self.result_label = tk.Label(self.root, text="النتيجة ستظهر هنا", font=("Arial", 10), fg="green")
 self.result_label.pack(pady=10)

 # 2. قسم الإعدادات
 tk.Label(self.root, text="عنوان الشراء (سيتم ملؤه تلقائياً):").pack(pady=5)
 self.address_entry = tk.Entry(self.root, font=("Arial", 10), width=30)
 self.address_entry.pack(pady=5)
 self.address_entry.insert(0, "جاري الحصول على العنوان...")

 tk.Label(self.root, text="مبلغ الشراء ($):").pack(pady=5)
 self.amount_entry = tk.Entry(self.root, font=("Arial", 10), width=15)
 self.amount_entry.pack(pady=5)
 self.amount_entry.insert(0, "100.00")

 # 3. زر الدفع
 btn_pay = tk.Button(self.root, text="💎 إتمام الدفع التلقائي", command=self.pay_action, bg="#4CAF50", fg="white", font=("Arial", 12, "bold"))
 btn_pay.pack(pady=20)

 def check_balance_action(self):
 bin_num = self.bin_entry.get().strip()
 if not bin_num:
 messagebox.showerror("خطأ", "يرجى إدخال رقم الـ BIN")
 return

 card_info = self.engine.check_balance(bin_num)
 if card_info:
 self.result_label.config(text=f"✅ البطاقة نشطة\n💰 الرصيد: ${card_info['Balance']:.2f}\n📍 العنوان: {card_info['Address']}")
 self.address_entry.delete(0, tk.END)
 self.address_entry.insert(0, card_info['Address'])
 else:
 self.result_label.config(text="❌ لم يتم العثور على البطاقة")

 def pay_action(self):
 bin_num = self.bin_entry.get().strip()
 amount = self.amount_entry.get().strip()
 address = self.address_entry.get().strip()
 target_url = "https://checkout.stripe.com/pay" # يمكنك تغيير هذا الرابط لموقعك

 if not bin_num or not amount:
 messagebox.showerror("خطأ", "يرجى ملء جميع الحقول")
 return

 try:
 amount = float(amount)
 except ValueError:
 messagebox.showerror("خطأ", "المبلغ يجب أن يكون رقماً")
 return

 # التحقق من الرصيد أولاً
 card_info = self.engine.check_balance(bin_num)
 
 if card_info:
 # التحقق من العنوان
 if address != card_info['Address']:
 messagebox.
showwarning("تنبيه", f"العنوان غير متطابق.\nالعنوان في البطاقة: {card_info['Address']}")
 return

 # إجراء الدفع
 success = self.engine.auto_submit_payment(card_info, amount, target_url)
 
 if success:
 messagebox.showinfo("نجاح", f"تم إتمام عملية الشراء بقيمة ${amount} بنجاح!")
 else:
 messagebox.showerror("فشل", "فشلت العملية. تأكد من الرابط المحدد.")
 else:
 messagebox.showerror("خطأ", "فشل التحقق من البطاقة")

if __name__ == "__main__":
 root = tk.Tk()
 app = PaymentApp(root)
 root.mainloop()
